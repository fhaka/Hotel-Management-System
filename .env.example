# Database (docker compose exposes Postgres on 5435)
DATABASE_URL="postgresql://imperial:imperial@localhost:5435/hotel_imperial?schema=public"

# Session signing secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
AUTH_SECRET="change-me"

# Public URL of the app
APP_URL="http://localhost:3000"

# Email (Mailpit catches all mail locally — inbox at http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Hotel Imperial <reservations@hotelimperial.al>"

# Payments: "demo" simulates card payments. Switch to "stripe" once keys are available.
PAYMENT_PROVIDER="demo"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Show demo shortcuts (demo logins, test-card hints). Set to "false" for production.
DEMO_MODE="true"
