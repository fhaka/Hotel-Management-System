// Hotel Imperial — data model
// Money columns are Decimal(10,2) in EUR. Room rates and service prices are VAT-inclusive (gross).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  RECEPTIONIST
  HOUSEKEEPING
  GUEST
}

enum RoomStatus {
  CLEAN
  DIRTY
  INSPECTED
  OUT_OF_ORDER
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  WEBSITE
  WALK_IN
  PHONE
  EMAIL
  OTA
  CORPORATE
}

enum ChargeType {
  ROOM
  SERVICE
  CITY_TAX
  DISCOUNT
  FEE
  OTHER
}

enum PaymentKind {
  CHARGE
  REFUND
}

enum PaymentMethod {
  CARD
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
}

enum InvoiceStatus {
  ISSUED
  PAID
  VOID
}

enum ServiceCategory {
  DINING
  SPA
  ROOM_SERVICE
  MINIBAR
  LAUNDRY
  TRANSPORT
  OTHER
}

enum TaskType {
  CHECKOUT_CLEAN
  STAYOVER
  INSPECTION
  MAINTENANCE
  TURNDOWN
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

enum PromoType {
  PERCENT
  FIXED_PER_NIGHT
}

enum EmailStatus {
  SENT
  FAILED
}

// ─── Identity ───────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         Role      @default(GUEST)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  guest               Guest?
  reservationsCreated Reservation[]      @relation("ReservationCreatedBy")
  chargesPosted       FolioCharge[]
  paymentsProcessed   Payment[]
  tasksAssigned       HousekeepingTask[]
  auditLogs           AuditLog[]
}

model Guest {
  id          String    @id @default(cuid())
  userId      String?   @unique
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName   String
  lastName    String
  email       String?   @unique
  phone       String?
  country     String?
  city        String?
  address     String?
  idType      String?
  idNumber    String?
  dateOfBirth DateTime? @db.Date
  vip         Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  reservations Reservation[]
  groupsBooked ReservationGroup[] @relation("GroupBooker")

  @@index([lastName, firstName])
}

// A business guests can be invoiced to (corporate accounts).
model Company {
  id          String   @id @default(cuid())
  name        String
  taxId       String?  @unique
  email       String?
  phone       String?
  address     String?
  city        String?
  country     String?
  contactName String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservations Reservation[]
  groups       ReservationGroup[]
}

// ─── Inventory ──────────────────────────────────────────────────────────────

model RoomType {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  description String
  baseRate    Decimal  @db.Decimal(10, 2)
  weekendRate Decimal? @db.Decimal(10, 2)
  maxAdults   Int
  maxChildren Int
  sizeSqm     Int
  bedType     String
  view        String
  amenities   String[]
  images      String[]
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms         Room[]
  reservations  Reservation[]
  seasonalRates SeasonalRate[]
  restrictions  StayRestriction[]
}

model Room {
  id               String     @id @default(cuid())
  number           String     @unique
  floor            Int
  roomTypeId       String
  roomType         RoomType   @relation(fields: [roomTypeId], references: [id])
  status           RoomStatus @default(CLEAN)
  outOfOrderReason String?
  notes            String?
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  reservations Reservation[]
  tasks        HousekeepingTask[]

  @@index([roomTypeId])
}

// Applies a multiplier to the nightly rate between two dates (inclusive start, exclusive end).
// roomTypeId = null applies to every room type.
model SeasonalRate {
  id         String    @id @default(cuid())
  name       String
  startDate  DateTime  @db.Date
  endDate    DateTime  @db.Date
  multiplier Decimal   @db.Decimal(4, 2)
  roomTypeId String?
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
}

// Booking rules applied to online bookings for arrivals or nights in [startDate, endDate).
// roomTypeId = null applies to every room type; weekdays (0 = Sunday) limit the rule to arrivals on those days.
model StayRestriction {
  id              String    @id @default(cuid())
  name            String
  startDate       DateTime  @db.Date
  endDate         DateTime  @db.Date
  roomTypeId      String?
  roomType        RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  weekdays        Int[]
  minNights       Int?
  closedToArrival Boolean   @default(false)
  stopSell        Boolean   @default(false)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
}

// Discount codes for room rates. validFrom/validTo bound the booking date, stayFrom/stayTo the arrival date.
model PromoCode {
  id          String    @id @default(cuid())
  code        String    @unique
  description String
  type        PromoType
  value       Decimal   @db.Decimal(10, 2)
  validFrom   DateTime? @db.Date
  validTo     DateTime? @db.Date
  stayFrom    DateTime? @db.Date
  stayTo      DateTime? @db.Date
  minNights   Int       @default(1)
  roomTypeIds String[]
  maxUses     Int?
  usedCount   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── Reservations & billing ─────────────────────────────────────────────────

model Reservation {
  id                 String            @id @default(cuid())
  code               String            @unique
  guestId            String
  guest              Guest             @relation(fields: [guestId], references: [id])
  roomTypeId         String
  roomType           RoomType          @relation(fields: [roomTypeId], references: [id])
  roomId             String?
  room               Room?             @relation(fields: [roomId], references: [id])
  checkIn            DateTime          @db.Date
  checkOut           DateTime          @db.Date
  adults             Int
  children           Int               @default(0)
  status             ReservationStatus @default(CONFIRMED)
  source             BookingSource     @default(WEBSITE)
  specialRequests    String?
  internalNotes      String?
  estimatedArrival   String?
  createdById        String?
  createdBy          User?             @relation("ReservationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  groupId            String?
  group              ReservationGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  companyId          String?
  company            Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  occupantName       String?
  promoCode          String?
  checkedInAt        DateTime?
  checkedOutAt       DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  charges  FolioCharge[]
  payments Payment[]
  invoice  Invoice?
  emails   EmailLog[]
  review   Review?

  @@index([checkIn, checkOut])
  @@index([status])
  @@index([guestId])
  @@index([roomId])
  @@index([groupId])
}

// Several rooms booked together under one booker and, by default, one bill.
model ReservationGroup {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  bookerId    String
  booker      Guest    @relation("GroupBooker", fields: [bookerId], references: [id])
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  // When true the group is settled and invoiced as one bill when the last room departs.
  singleBill  Boolean  @default(true)
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservations Reservation[]
  invoice      Invoice?
  emails       EmailLog[]
}

model FolioCharge {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  type          ChargeType
  description   String
  date          DateTime    @db.Date
  quantity      Int         @default(1)
  unitPrice     Decimal     @db.Decimal(10, 2)
  amount        Decimal     @db.Decimal(10, 2)
  vatRate       Decimal     @db.Decimal(5, 2)
  serviceId     String?
  service       Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  postedById    String?
  postedBy      User?       @relation(fields: [postedById], references: [id], onDelete: SetNull)
  voided        Boolean     @default(false)
  voidReason    String?
  createdAt     DateTime    @default(now())

  @@index([reservationId])
}

model Payment {
  id            String        @id @default(cuid())
  reservationId String
  reservation   Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  kind          PaymentKind   @default(CHARGE)
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        PaymentStatus @default(SUCCEEDED)
  provider      String
  providerRef   String?
  cardBrand     String?
  cardLast4     String?
  note          String?
  processedById String?
  processedBy   User?         @relation(fields: [processedById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())

  @@index([reservationId])
  @@index([createdAt])
}

model Invoice {
  id            String            @id @default(cuid())
  number        String            @unique
  reservationId String?           @unique
  reservation   Reservation?      @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  groupId       String?           @unique
  group         ReservationGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status        InvoiceStatus     @default(ISSUED)
  netTotal      Decimal           @db.Decimal(10, 2)
  vatTotal      Decimal           @db.Decimal(10, 2)
  total         Decimal           @db.Decimal(10, 2)
  billTo        String
  billToTaxId   String?
  billToAddress String?
  issuedAt      DateTime          @default(now())
}

// ─── Services & operations ──────────────────────────────────────────────────

model Service {
  id          String          @id @default(cuid())
  name        String
  category    ServiceCategory
  description String?
  price       Decimal         @db.Decimal(10, 2)
  unit        String          @default("item")
  // Offered as an add-on during online booking; perNight/perGuest control how the quantity is derived.
  bookable    Boolean         @default(false)
  perNight    Boolean         @default(false)
  perGuest    Boolean         @default(false)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  charges FolioCharge[]
}

model HousekeepingTask {
  id           String     @id @default(cuid())
  roomId       String
  room         Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  type         TaskType
  status       TaskStatus @default(PENDING)
  priority     Priority   @default(NORMAL)
  notes        String?
  assignedToId String?
  assignedTo   User?      @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  dueDate      DateTime   @db.Date
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, dueDate])
}

model Review {
  id            String       @id @default(cuid())
  reservationId String?      @unique
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guestName     String
  country       String?
  rating        Int
  title         String
  body          String
  published     Boolean      @default(true)
  createdAt     DateTime     @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EmailLog {
  id            String            @id @default(cuid())
  to            String
  subject       String
  template      String
  status        EmailStatus
  error         String?
  reservationId String?
  reservation   Reservation?      @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  groupId       String?
  group         ReservationGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  summary   String
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// Single row (id = 1) holding editable hotel configuration.
model HotelSettings {
  id                    Int      @id @default(1)
  name                  String
  legalName             String
  taxId                 String
  email                 String
  phone                 String
  address               String
  city                  String
  country               String
  currency              String   @default("EUR")
  vatRate               Decimal  @db.Decimal(5, 2)
  cityTaxPerPersonNight Decimal  @db.Decimal(10, 2)
  checkInTime           String
  checkOutTime          String
  freeCancellationHours Int
  updatedAt             DateTime @updatedAt
}
